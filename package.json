{
  "name": "crux",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --use-env-proxy node_modules/next/dist/bin/next dev",
    "build": "next build",
    "start": "node --use-env-proxy node_modules/next/dist/bin/next start",
    "lint": "eslint",
    "research": "tsx --use-env-proxy --env-file-if-exists=.env.local scripts/research.ts",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "next": "16.3.6",
    "openai": "^7.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
