# Arkiv (Tiramisu testnet, chain 7738577). Runs are published here and read back from here.
# A funded Tiramisu wallet's private key. Never commit it. Reading works without it.
ARKIV_PRIVATE_KEY=
# ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
# How long published runs live before anyone needs to extend them (days).
# ARKIV_TTL_DAYS=365

# SERV Reasoning (OpenAI-compatible). Without it, the app runs on mock fixtures.
SERV_API_KEY=
# SERV_MODEL=gpt-5.4-mini
# SERV_SHADOW_AGENT=1

# Web search for the research stage. Without it, research uses mock sources.
TAVILY_API_KEY=

# Force mock research even when keys are set (runs still publish to Arkiv).
# STET_MOCK=1
# Save runs to a local folder when there's no Arkiv key (offline development only).
# STET_LOCAL_STORE=1
# Offline stand-in for Arkiv (development only; nothing is published).
# STET_ARKIV_MEMORY=1
